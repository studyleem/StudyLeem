rules_version = '2';

// StudyLeem – complete Firestore security rules
// Publish: Firebase console -> Firestore Database -> Rules -> paste -> Publish
//          (or: firebase deploy --only firestore:rules)
// The Google Apps Script auto-publisher/blog uses a service account, which bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ───────── helpers ───────── */
    function isAdmin() {
      return request.auth != null
          && request.auth.uid == 'FtNUvUpPIxfMMO1ag5SARCMqDqE3';   // same UID as ADMIN_UIDS in firebase-client.js
    }
    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    /* ───────── notes & books ─────────
       Everyone can read (the public website). Only the admin can create / edit / delete. */
    match /materials/{materialId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ───────── blog ─────────
       Visitors can read PUBLISHED posts only (queries must filter status == 'published', as the site does).
       Admin can read drafts and write. */
    match /blogPosts/{slug} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.status in ['published', 'draft']
                            && isText(request.resource.data.title, 200)
                            && isText(request.resource.data.content, 60000);
      allow delete: if isAdmin();
    }

    /* ───────── contact form ─────────
       Anyone can SEND one well-formed message (no reading it back). Only the admin can read / mark read / delete. */
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subjectLabel', 'message', 'read', 'sentAt'])
                    && request.resource.data.keys().hasAll(['name', 'email', 'subjectLabel', 'message', 'read', 'sentAt'])
                    && isText(request.resource.data.name, 120)    && request.resource.data.name.size() > 0
                    && isText(request.resource.data.email, 200)
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && isText(request.resource.data.subjectLabel, 200)
                    && isText(request.resource.data.message, 5000) && request.resource.data.message.size() > 0
                    && request.resource.data.read == false
                    && request.resource.data.sentAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    /* ───────── everything else is locked ───────── */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
