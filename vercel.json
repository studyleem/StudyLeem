{
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/home",
      "destination": "/home.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/admin-secure-panel-sl786",
      "destination": "/admin.html"
    },
    {
      "source": "/fbise",
      "destination": "/fbise.html"
    },
    {
      "source": "/fbise/:class(9|10|11|12)",
      "destination": "/fbise-subject.html"
    },
    {
      "source": "/fbise/:class(9|10|11|12)/:subject",
      "destination": "/fbise-hub.html"
    },
    {
      "source": "/fbise/:class(9|10|11|12)/:subject/:type",
      "destination": "/fbise-hub.html"
    },
    {
      "source": "/fbise/:class(9|10|11|12)/:subject/:type/:slug",
      "destination": "/material.html"
    },
    {
      "source": "/fbise/:type",
      "destination": "/fbise-all.html"
    },
    {
      "source": "/fbise/:type/:class",
      "destination": "/fbise-subject.html"
    },
    {
      "source": "/fbise/:type/:class/:subject",
      "destination": "/fbise-hub.html"
    },
    {
      "source": "/fbise/:type/:class/:subject/:chapter",
      "destination": "/material.html"
    },
    {
      "source": "/class",
      "destination": "/class.html"
    },
    {
      "source": "/subject",
      "destination": "/subject.html"
    },
    {
      "source": "/pdf-preview",
      "destination": "/pdf-preview.html"
    },
    {
      "source": "/leemai",
      "destination": "/leemai.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog-post.html"
    },
    {
      "source": "/sitemap-materials.xml",
      "destination": "/api/sitemap-materials"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap-blog"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/admin-secure-panel-sl786",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/pdf-preview",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/pdf-proxy.js": {
      "maxDuration": 30
    },
    "api/pdf-ai.js": {
      "maxDuration": 30
    },
    "api/ask.js": {
      "maxDuration": 30
    },
    "api/quiz.js": {
      "maxDuration": 60
    },
    "api/check.js": {
      "maxDuration": 60
    },
    "api/sitemap-materials.js": {
      "maxDuration": 20
    },
    "api/sitemap-blog.js": {
      "maxDuration": 20
    }
  },
  "redirects": [
    {
      "source": "/fbise/:type([a-z][a-z0-9-]*)/:class(9|10|11|12)/:subject/:chapter",
      "destination": "/fbise/:class/:subject/:type/:chapter",
      "permanent": true
    },
    {
      "source": "/fbise/:type([a-z][a-z0-9-]*)/:class(9|10|11|12)/:subject",
      "destination": "/fbise/:class/:subject",
      "permanent": true
    }
  ]
}