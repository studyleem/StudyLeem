{
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/home",
      "destination": "/home.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/admin-secure-panel-sl786",
      "destination": "/admin.html"
    },
    {
      "source": "/fbise",
      "destination": "/fbise.html"
    },
    {
      "source": "/fbise/notes",
      "destination": "/fbise-all.html"
    },
    {
      "source": "/fbise/notes/:class",
      "destination": "/fbise-subject.html"
    },
    {
      "source": "/fbise/books",
      "destination": "/fbise-all.html"
    },
    {
      "source": "/fbise/books/:class",
      "destination": "/fbise-subject.html"
    },
    {
      "source": "/fbise/notes/:class/:subject",
      "destination": "/fbise-chapters.html"
    },
    {
      "source": "/fbise/books/:class/:subject",
      "destination": "/fbise-chapters.html"
    },
    {
      "source": "/fbise/notes/:class/:subject/:chapter",
      "destination": "/fbise-viewer.html"
    },
    {
      "source": "/fbise/books/:class/:subject/:chapter",
      "destination": "/fbise-viewer.html"
    },
    {
      "source": "/class",
      "destination": "/class.html"
    },
    {
      "source": "/subject",
      "destination": "/subject.html"
    },
    {
      "source": "/pdf-preview",
      "destination": "/pdf-preview.html"
    },
    {
      "source": "/leemai",
      "destination": "/leemai.html"
    },
    {
      "source": "/sitemap-materials.xml",
      "destination": "/api/sitemap-materials"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/admin-secure-panel-sl786",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/pdf-preview",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/pdf-proxy.js": {
      "maxDuration": 30
    },
    "api/pdf-ai.js": {
      "maxDuration": 30
    },
    "api/ask.js": {
      "maxDuration": 30
    },
    "api/quiz.js": {
      "maxDuration": 60
    },
    "api/check.js": {
      "maxDuration": 60
    },
    "api/sitemap-materials.js": {
      "maxDuration": 20
    }
  }
}